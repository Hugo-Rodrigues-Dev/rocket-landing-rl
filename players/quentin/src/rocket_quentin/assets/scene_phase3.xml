<mujoco model="quentin_phase_3">
    <option timestep="0.005" gravity="0 0 -9.81"/>
    <include file="ocean.xml"/>

    <worldbody>
        <geom name="sea" type="plane" size="0 0 0.1" material="ocean" contype="2" conaffinity="1"/>
        <!-- Les charnières pivotent autour du centre de la surface du pont. -->
        <body name="barge" pos="0 0 1">
            <joint name="barge_x" type="slide" axis="1 0 0"/>
            <joint name="barge_y" type="slide" axis="0 1 0"/>
            <joint name="barge_heave" type="slide" axis="0 0 1"/>
            <joint name="barge_roll" type="hinge" axis="1 0 0"/>
            <joint name="barge_pitch" type="hinge" axis="0 1 0"/>
            <geom name="deck" type="box" pos="0 0 -0.5" size="7.5 7.5 0.5" mass="1000000"
                  rgba="0.32 0.36 0.39 1" contype="4" conaffinity="1"/>
        </body>
        <include file="rocket.xml"/>
    </worldbody>
</mujoco>
